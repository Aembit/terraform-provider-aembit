{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "cloneSubmodules": true,
  "minimumReleaseAge": "14 days",
  "separateMajorMinor": false,
  "pinDigests": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Prevent Renovate from attempting to pin Docker digests on action inputs (e.g., renovate-version)",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not pin or update GitHub Actions or reusable workflows referenced by branch name (e.g., @main); always keep live branch reference",
      "matchManagers": [
        "github-actions"
      ],
      "matchCurrentValue": "/^main$/",
      "pinDigests": false
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules (all versions)",
      "separateMajorMinor": false,
      "groupSingleUpdates": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions (all versions)",
      "separateMajorMinor": false,
      "groupSingleUpdates": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker dependencies (all versions)",
      "separateMajorMinor": false,
      "groupSingleUpdates": true,
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    }
  ]
}
